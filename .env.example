# Server port (default 5334)
PORT=5334

# Admin password for the dashboard (CHANGE THIS)
ADMIN_PASSWORD=changeme

# Where the SQLite database + uploaded/signed PDFs live (default: ./data)
# DATA_DIR=/path/to/data

# Public base URL used in signing invitation emails (e.g. https://sign.yourdomain.com)
# Falls back to the request's own host if unset. Can also be set in-app under Settings.
# BASE_URL=

# SMTP is optional and configured in-app under Settings → Email (stored in the DB).
# Without SMTP, signing links are shown in the UI for you to copy/paste manually.
